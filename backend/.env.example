# ---------------------------------------------------------------------------
# Margin API configuration. Copy to backend/.env and fill in real values.
# Never commit backend/.env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string (local instance or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/margin

# Browser origin(s) allowed to call the API, comma-separated.
# The first entry is where OAuth sends users back after signing in.
CLIENT_URL=http://localhost:5173
# Public base URL of this API (used to build OAuth callback URLs)
API_URL=http://localhost:5000

# Number of reverse-proxy hops in front of the API (0 = none). Set to 1 behind a
# single load balancer so req.ip / rate limiting use the real client address.
TRUST_PROXY=0
# Refresh-cookie SameSite policy. Keep "lax" when the client and API share a site;
# use "none" only when they are on different sites (forces Secure cookies).
COOKIE_SAMESITE=lax

# JWT signing secrets: at least 32 random characters each, and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (cover image uploads). Uploads return 503 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary folder that cover images are uploaded into
CLOUDINARY_FOLDER=blogsystem

# Google OAuth 2.0. Callback defaults to ${API_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Facebook Login. Callback defaults to ${API_URL}/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Used only by `npm run seed:admin` (can also be passed inline on the command line)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
