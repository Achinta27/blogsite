# Base URL of the Margin API. Leave unset in development: Vite proxies /api to the backend.
# In production set it to the deployed API, e.g. https://api.example.com/api/v1
VITE_API_URL=

# Socket.IO server origin. Leave unset when the API is served from the same origin
# (development proxies /socket.io). In production e.g. https://api.example.com
VITE_SOCKET_URL=
